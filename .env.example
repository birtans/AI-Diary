# ============================================================
# AI Diary — environment template
# Copy to .env for local docker-compose. Production values are
# supplied by Coolify; never commit the real file.
# ============================================================

# ---- Master key (the single most important secret) ----
# Generate: openssl rand -base64 32
DIARY_MASTER_KEY=

# ---- Postgres ----
DIARY_DB_CONNECTION=Host=postgres;Port=5432;Database=diary;Username=diary;Password=diary

# ---- S3-compatible storage (Backblaze B2 in prod, MinIO in dev) ----
DIARY_S3_ENDPOINT=http://minio:9000
# Endpoint used to SIGN presigned URLs the browser fetches ciphertext from
# directly (leave empty to reuse DIARY_S3_ENDPOINT — correct when it's
# already public, e.g. B2). In docker-compose dev, MinIO is only reachable
# by its internal hostname from the API but by localhost from the browser.
DIARY_S3_PUBLIC_ENDPOINT=http://localhost:9000
DIARY_S3_REGION=eu-central-1
DIARY_S3_BUCKET=diary
DIARY_S3_ACCESS_KEY=minioadmin
DIARY_S3_SECRET_KEY=minioadmin
DIARY_S3_FORCE_PATH_STYLE=true
DIARY_S3_PRESIGN_TTL_SECONDS=300

# ---- Ollama ----
DIARY_OLLAMA_URL=http://ollama:11434
DIARY_EMBED_MODEL=bge-m3

# ---- Keycloak / OIDC ----
# Authority is what the BROWSER sees (used in redirects and token issuer).
DIARY_OIDC_AUTHORITY=http://localhost:8082/realms/diary
# Internal URL the API uses to reach Keycloak (leave empty when running the
# API on the host; set to http://keycloak:8080 inside docker — the compose
# file already defaults it).
DIARY_OIDC_INTERNAL_URL=
DIARY_OIDC_CLIENT_ID=diary-api
DIARY_OIDC_CLIENT_SECRET=dev-admin-secret-change-me
# Audience the API validates on access tokens (SPA client id)
DIARY_OIDC_AUDIENCE=diary-web

# ---- Admin ----
DIARY_ADMIN_EMAIL=admin@example.com

# ---- Captcha (turnstile | hcaptcha | none) ----
DIARY_CAPTCHA_PROVIDER=none
DIARY_CAPTCHA_SECRET=
DIARY_CAPTCHA_SITE_KEY=

# ---- Retention (policy defaults, see spec) ----
DIARY_VERSION_RETENTION_DAYS=90
DIARY_TRASH_RETENTION_DAYS=30
DIARY_CONVERSATION_RETENTION_DAYS=30

# ---- Misc API ----
# Comma-separated origins allowed for CORS (Vite dev server + web container)
DIARY_CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8083
# Public base URL used in generated links (recovery kit README)
DIARY_BASE_URL=http://localhost:8080

# ---- Compose-only -------
# Host port for the web container (pick another if 8081 is taken)
WEB_PORT=8083

# ---- Optional SMTP for admin notifications (access requests) ----
# When unset, notifications are only logged.
DIARY_SMTP_HOST=
DIARY_SMTP_PORT=587
DIARY_SMTP_USERNAME=
DIARY_SMTP_PASSWORD=
DIARY_SMTP_FROM=

# ---- Keycloak container (dev) ----
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

# ---- Postgres container (dev) ----
POSTGRES_USER=diary
POSTGRES_PASSWORD=diary
POSTGRES_DB=diary
